{
  "buildCommand": "echo 'No build needed - built HTML/CSS is committed to the repo'",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/services/premium-nri-care", "destination": "/nri-hearing-care", "permanent": true },
    { "source": "/booking/premium-nri-care", "destination": "/nri-hearing-care", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
